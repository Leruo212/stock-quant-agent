# ============ 大模型预测 ============
# 任选一个 OpenAI 兼容的服务。留空 api key 时，`forecast` 会退化为启发式占位输出
# （页面和 CLI 都会明确标注「不是大模型结论」）。
#
# DeepSeek:  https://api.deepseek.com/v1                     模型 deepseek-chat
# 通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1  模型 qwen-plus
# 月之暗面:  https://api.moonshot.cn/v1                       模型 moonshot-v1-8k
# 智谱:      https://open.bigmodel.cn/api/paas/v4             模型 glm-4-plus
# Ollama:    http://localhost:11434/v1                        模型 qwen2.5:7b
QA_LLM_BASE_URL=https://api.deepseek.com/v1
QA_LLM_MODEL=deepseek-chat
QA_LLM_API_KEY=

# 自一致性采样次数：>1 时同一 prompt 采样多次，用分歧度当不确定性估计（会成倍消耗 token）
QA_LLM_SAMPLES=1

# 预测通道：auto（有 key 就走真实 API）| openai | mock（确定性占位，用于离线验证链路）
# QA_LLM_PROVIDER=auto

# 可选：数据与产物目录覆盖
# QA_CACHE_DIR=./data/cache
# QA_ARTIFACT_DIR=./artifacts
# QA_REPORT_DIR=./reports
# QA_LEDGER_DIR=./data/ledger
