# 量化 Agent 的 LLM 配置。任选一个 OpenAI 兼容的服务，留空则自动使用本地规划模式。
# DeepSeek:  https://api.deepseek.com/v1     模型 deepseek-chat
# 通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1   模型 qwen-plus
# Ollama:    http://localhost:11434/v1       模型 qwen2.5:7b
QA_LLM_BASE_URL=https://api.deepseek.com/v1
QA_LLM_MODEL=deepseek-chat
QA_LLM_API_KEY=

# 可选：数据与产物目录覆盖
# QA_CACHE_DIR=./data/cache
# QA_ARTIFACT_DIR=./artifacts
# QA_REPORT_DIR=./reports
